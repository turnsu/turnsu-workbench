# Template for local agent-runtime secrets. Copy to `.env` and fill in real keys.
#   cp .env.example .env   # then edit .env
# `.env` is git-ignored; never commit real keys (also enforced by agent.md secrets boundary).

# DeepSeek — primary text planner / tool-calling model. Required for live agent reasoning.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# Kimi / Moonshot — vision / image attachment analysis. Optional (only for image tasks).
KIMI_API_KEY=replace_with_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-k2.6

# Alibaba Cloud Bailian / DashScope — non-realtime meeting audio/video ASR.
# User-dropped audio/video is temporarily uploaded to OSS, then submitted to DashScope ASR.
DASHSCOPE_API_KEY=replace_with_dashscope_or_bailian_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_ASR_MODEL=fun-asr
BAILIAN_ASR_FALLBACK_MODEL=qwen3-asr-flash-filetrans
CLOUD_ASR_TIMEOUT_MS=900000
CLOUD_ASR_POLL_INTERVAL_MS=2000
CLOUD_ASR_UPLOAD_TTL_SECONDS=86400
ALIYUN_OSS_BUCKET=meetingagent-feishu
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=replace_with_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace_with_oss_access_key_secret
ALIYUN_OSS_SECURITY_TOKEN=

# Skill / Loop Workbench local services. Vite uses 5184 and proxies the Product API to 8798.
WORKBENCH_PORT=8798
# Local development uses the pinned PostgreSQL image in docker-compose.yml.
# Production sets WORKBENCH_MANAGED_POSTGRES=1 and injects a managed PostgreSQL DSN.
WORKBENCH_MANAGED_POSTGRES=0
WORKBENCH_POSTGRES_DATA_DIR=/absolute/local/runtime/postgres-data
WORKBENCH_SECRETS_DIR=/absolute/local/runtime/secrets
# The local secrets directory must contain `postgres-password` with mode 0600.
WORKBENCH_POSTGRES_BIND_IP=127.0.0.1
WORKBENCH_POSTGRES_PORT=5432
WORKBENCH_POSTGRES_USER=looloomi
WORKBENCH_POSTGRES_DATABASE=looloomi_workbench
WORKBENCH_POSTGRES_CONTAINER_NAME=looloomi-postgres
WORKBENCH_POSTGRES_URL=postgresql://looloomi:replace_with_local_password@127.0.0.1:5432/looloomi_workbench?sslmode=disable
# Governed Skill runtimes. Each configured runtime must use a locally available immutable image digest.
WORKBENCH_DOCKER_IMAGE=repository/image@sha256:replace_with_64_hex_digest
WORKBENCH_NODE_SKILL_IMAGE=repository/node-typescript-image@sha256:replace_with_64_hex_digest

# The DEEPSEEK_* variables above are not implicitly imported into the Product
# model catalog. Provider bindings are resolved through a governed Secret Store.
WORKBENCH_LOCAL_PRODUCTION=0
# The product exposes one default team workspace in this release. Tenant fields
# and filters remain mandatory in persistence and authorization.
WORKBENCH_DEFAULT_WORKSPACE_ID=workspace-local
WORKBENCH_DEFAULT_WORKSPACE_NAME=Team workspace
WORKBENCH_REGISTRATION_OPEN=true
WORKBENCH_BOOTSTRAP_ADMIN_TOKEN=replace_with_one_time_bootstrap_token
# bcrypt cost is intentionally bounded by the server to 10..14.
WORKBENCH_BCRYPT_COST=12

# Email invitations and Google/GitHub OAuth. Production enables this only
# behind the exact HTTPS public origin. Secret values are mounted by the
# deployment Secret Store and referenced by absolute file path; do not put
# signing, SMTP, or OAuth client secrets directly in environment variables.
WORKBENCH_IDENTITY_ENABLED=false
WORKBENCH_PUBLIC_ORIGIN=https://workspace.example.com
WORKBENCH_IDENTITY_SIGNING_SECRET_FILE=/run/secrets/workbench-identity-signing
WORKBENCH_SMTP_HOST=smtp.example.com
WORKBENCH_SMTP_PORT=465
WORKBENCH_SMTP_USERNAME=workspace@example.com
WORKBENCH_SMTP_PASSWORD_FILE=/run/secrets/workbench-smtp-password
WORKBENCH_SMTP_FROM=workspace@example.com
WORKBENCH_SMTP_TLS_MODE=implicit-tls
WORKBENCH_SMTP_SERVERNAME=smtp.example.com
WORKBENCH_SMTP_CLIENT_NAME=workspace.example.com
WORKBENCH_SMTP_TIMEOUT_MS=15000
WORKBENCH_GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
WORKBENCH_GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/workbench-google-oauth-client-secret
WORKBENCH_GITHUB_OAUTH_CLIENT_ID=replace_with_github_oauth_client_id
WORKBENCH_GITHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/workbench-github-oauth-client-secret
# Desktop/Mobile native clients use system-browser approval plus PKCE. Loopback
# callbacks work without extra configuration; list only exact HTTPS app origins
# (comma separated) when a non-loopback native redirect is required.
WORKBENCH_NATIVE_REDIRECT_ORIGINS=
WORKBENCH_NATIVE_AUTHORIZATION_PATH=/native/authorize

WORKBENCH_SKILL_IMPORT_ROOTS=/absolute/allowed/skill/root
WORKBENCH_AGENT_IMAGE=looloomi-agent-worker@sha256:replace_with_64_hex_digest
# Required with WORKBENCH_AGENT_IMAGE. Generate and inject a stable 32-byte key
# through the deployment secret manager; do not commit a real key here.
WORKBENCH_TRANSCRIPT_ARTIFACT_KEY_BASE64=replace_with_base64_encoded_32_byte_key
WORKBENCH_TRANSCRIPT_ARTIFACT_KEY_ID=worker-transcript-key-v1
# Model Profile and policy writes require the governed PostgreSQL command path;
# no environment importer or credential fallback is enabled.
# Explicit scoped readiness requirements; no workspace-wide latest-policy fallback is used.
# Example: [{"workspaceId":"workspace-local","userId":"user-example","capabilities":["chat","tool_calling"]}]
WORKBENCH_MODEL_ROUTING_REQUIREMENTS_JSON=
# Local/self-hosted cloud Secret Store reference adapter. Secret bindings use
# `<name>:<revision>`. New model setup resolves files under
# `${WORKBENCH_CLOUD_SECRET_STORE_DIR}/<workspaceId>/<name>.v<revision>.secret`.
# Existing bindings and Connection references retain their original root layout.
# Every mounted secret file must be a regular 0600 file. Values never belong in
# this environment file. A Vault/OpenBao adapter can implement the same port.
WORKBENCH_CLOUD_SECRET_STORE_DIR=/absolute/local/runtime/cloud-secrets
WORKBENCH_LARK_CLI_PATH=
WORKBENCH_LARK_PROFILE_PREFIX=workbench
# Reject loopback provider endpoints unless an operator explicitly opts into
# a controlled local provider.
WORKBENCH_MODEL_ALLOW_LOOPBACK_ENDPOINTS=0
# Provider call deadline (milliseconds).
WORKBENCH_MODEL_TIMEOUT_MS=60000
# Optional manual-development catalog inputs. Prefer CATALOG_IMPORT_JSON; the
# other two remain compatibility inputs and must never contain committed keys.
WORKBENCH_MODEL_PROFILES_JSON=
WORKBENCH_MODEL_DEFAULT_PROFILE=
WORKBENCH_MODEL_CREDENTIALS_JSON=
# Legacy single OpenAI-compatible configuration remains accepted only for existing installations:
# WORKBENCH_MODEL_BASE_URL=https://provider.example/v1
# WORKBENCH_MODEL_API_KEY=replace_for_manual_development_only
# WORKBENCH_MODEL=provider/model-id
WORKBENCH_OBJECT_STORE_ROOT=/absolute/local/runtime/objects
WORKBENCH_EXECUTION_ROOT=/absolute/local/runtime/executions
WORKBENCH_AGENT_SANDBOX_ROOT=/absolute/local/runtime/agent-sandbox
WORKBENCH_LOG_LEVEL=info

# Live WeChat read-only refresh. Disabled by default; requires local wechat-cli setup.
WECHAT_LIVE_ENABLED=false
WECHAT_CLI_PATH=

# CoinMarketCap Skill Hub MCP / Pro API — backend daemon refreshes normalized local artifacts.
CMC_PROVIDER_ORDER=mcp_http,mcp_bridge,rest,normalized,fixture
CMC_MCP_ENDPOINT=https://mcp.coinmarketcap.com/skill-hub/stream
CMC_MCP_API_KEY=replace_with_cmc_mcp_key
# Optional comma-separated fallback keys. Runtime tries CMC_MCP_API_KEY first, then these keys on quota/rate-limit/auth/plan failures.
CMC_MCP_API_KEYS=
CMC_HTTP_PROXY=
CMC_SKILL_HUB_BRIDGE_CMD=
CMC_PRO_API_KEY=replace_with_cmc_key
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_DEFAULT_SYMBOLS=BTC,ETH,SOL
CMC_REFRESH_TTL_SECONDS=900
CMC_CLI_CMD=
