# Template for local agent-runtime secrets. Copy to `.env` and fill in real keys.
#   cp .env.example .env   # then edit .env
# `.env` is git-ignored; never commit real keys (also enforced by agent.md secrets boundary).

# DeepSeek — primary text planner / tool-calling model. Required for live agent reasoning.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# Kimi / Moonshot — vision / image attachment analysis. Optional (only for image tasks).
KIMI_API_KEY=replace_with_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-k2.6

# Agent Runtime Host daemon bind address (defaults match the Swift app).
WECHAT_AGENT_DAEMON_HOST=127.0.0.1
WECHAT_AGENT_DAEMON_PORT=8797
WECHAT_AGENT_MAX_BODY_BYTES=1048576

# Local Agent Workbench data store. The default is the project Docker MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=looloomi_agent

# Live WeChat read-only refresh. Disabled by default; requires local wechat-cli setup.
WECHAT_LIVE_ENABLED=false
WECHAT_CLI_PATH=

# CoinMarketCap Skill Hub MCP / Pro API — backend daemon refreshes normalized local artifacts.
CMC_PROVIDER_ORDER=mcp_http,mcp_bridge,rest,normalized,fixture
CMC_MCP_ENDPOINT=https://mcp.coinmarketcap.com/skill-hub/stream
CMC_MCP_API_KEY=replace_with_cmc_mcp_key
CMC_HTTP_PROXY=
CMC_SKILL_HUB_BRIDGE_CMD=
CMC_PRO_API_KEY=replace_with_cmc_key
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_DEFAULT_SYMBOLS=BTC,ETH,SOL
CMC_REFRESH_TTL_SECONDS=900
CMC_CLI_CMD=
