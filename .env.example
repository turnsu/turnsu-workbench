# Template for local agent-runtime secrets. Copy to `.env` and fill in real keys.
#   cp .env.example .env   # then edit .env
# `.env` is git-ignored; never commit real keys (also enforced by agent.md secrets boundary).

# DeepSeek — primary text planner / tool-calling model. Required for live agent reasoning.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# Kimi / Moonshot — vision / image attachment analysis. Optional (only for image tasks).
KIMI_API_KEY=replace_with_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-k2.6

# Alibaba Cloud Bailian / DashScope — non-realtime meeting audio/video ASR.
# User-dropped audio/video is temporarily uploaded to OSS, then submitted to DashScope ASR.
DASHSCOPE_API_KEY=replace_with_dashscope_or_bailian_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_ASR_MODEL=fun-asr
BAILIAN_ASR_FALLBACK_MODEL=qwen3-asr-flash-filetrans
CLOUD_ASR_TIMEOUT_MS=900000
CLOUD_ASR_POLL_INTERVAL_MS=2000
CLOUD_ASR_UPLOAD_TTL_SECONDS=86400
ALIYUN_OSS_BUCKET=meetingagent-feishu
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=replace_with_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace_with_oss_access_key_secret
ALIYUN_OSS_SECURITY_TOKEN=

# Agent Runtime Host daemon bind address (defaults match the Swift app).
WECHAT_AGENT_DAEMON_HOST=127.0.0.1
WECHAT_AGENT_DAEMON_PORT=8797
WECHAT_AGENT_MAX_BODY_BYTES=1048576

# Skill / Loop Workbench local services. Vite uses 5184 and proxies the Product API to 8798.
# Keep the Product API separate from the legacy Agent daemon on 8797.
WORKBENCH_PORT=8798
# Required by the aggregate V1 proof. Use a locally available immutable image digest.
WORKBENCH_DOCKER_IMAGE=repository/image@sha256:replace_with_64_hex_digest

# Backend / Agent Slice 0-4 manual-development composition. The DEEPSEEK_* variables above belong
# to the Agent runtime and are not implicitly imported into the Workbench Model Catalog.
# The production local daemon uses `workbench-local configure` plus macOS Keychain.
WORKBENCH_LOCAL_PRODUCTION=0
WORKBENCH_MONGODB_URI=mongodb://workbench_admin:replace_with_local_password@127.0.0.1:27017/?replicaSet=rs0&authSource=admin
WORKBENCH_MONGODB_DB=looloomi_workbench
WORKBENCH_AGENT_IMAGE=looloomi-agent-worker@sha256:replace_with_64_hex_digest
# Optional explicit catalog import for manual development. It is an operator import input only;
# after import, Mongo profile revisions and routing policies are runtime truth. Never put secrets in it.
WORKBENCH_MODEL_CATALOG_IMPORT_JSON=
# Explicit readiness requirements; the local daemon derives this from capability-default policy keys.
# Example: [{"workspaceId":"workspace-local","capabilities":["chat","tool_calling","structured_output"]}]
WORKBENCH_MODEL_ROUTING_REQUIREMENTS_JSON=
# Manual macOS development can use the same lazy resolver after creating
# `model-credential:<credentialRef>` under this service. Never place the credential in the import JSON.
WORKBENCH_MODEL_KEYCHAIN_SERVICE=com.looloomi.workbench.local
# Legacy single OpenAI-compatible configuration remains accepted only for existing installations:
# WORKBENCH_MODEL_BASE_URL=https://provider.example/v1
# WORKBENCH_MODEL_API_KEY=replace_for_manual_development_only
# WORKBENCH_MODEL=provider/model-id
WORKBENCH_OBJECT_STORE_ROOT=/absolute/local/runtime/objects
WORKBENCH_EXECUTION_ROOT=/absolute/local/runtime/executions
WORKBENCH_AGENT_SANDBOX_ROOT=/absolute/local/runtime/agent-sandbox
WORKBENCH_LOG_LEVEL=info

# Local Agent Workbench data store. The default is the project Docker MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=looloomi_agent

# Live WeChat read-only refresh. Disabled by default; requires local wechat-cli setup.
WECHAT_LIVE_ENABLED=false
WECHAT_CLI_PATH=

# CoinMarketCap Skill Hub MCP / Pro API — backend daemon refreshes normalized local artifacts.
CMC_PROVIDER_ORDER=mcp_http,mcp_bridge,rest,normalized,fixture
CMC_MCP_ENDPOINT=https://mcp.coinmarketcap.com/skill-hub/stream
CMC_MCP_API_KEY=replace_with_cmc_mcp_key
# Optional comma-separated fallback keys. Runtime tries CMC_MCP_API_KEY first, then these keys on quota/rate-limit/auth/plan failures.
CMC_MCP_API_KEYS=
CMC_HTTP_PROXY=
CMC_SKILL_HUB_BRIDGE_CMD=
CMC_PRO_API_KEY=replace_with_cmc_key
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_DEFAULT_SYMBOLS=BTC,ETH,SOL
CMC_REFRESH_TTL_SECONDS=900
CMC_CLI_CMD=
