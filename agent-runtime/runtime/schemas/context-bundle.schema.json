{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-context-bundle.schema.json",
  "title": "Agent Context Bundle",
  "type": "object",
  "required": ["schemaVersion", "runID", "taskID", "bundleID", "includedChunks", "modelContext", "budget"],
  "properties": {
    "schemaVersion": { "const": "agent-context-bundle-v1" },
    "runID": { "type": "string" },
    "taskID": { "type": "string" },
    "bundleID": { "type": "string" },
    "includedChunks": { "type": "array" },
    "modelContext": { "type": "string" },
    "budget": { "type": "object" }
  }
}

