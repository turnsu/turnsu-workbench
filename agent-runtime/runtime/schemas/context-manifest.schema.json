{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-context-manifest.schema.json",
  "title": "Agent Context Manifest",
  "type": "object",
  "required": ["schemaVersion", "runID", "taskID", "sources", "chunks", "rawPrivateTranscriptIncluded"],
  "properties": {
    "schemaVersion": { "const": "agent-context-manifest-v1" },
    "runID": { "type": "string" },
    "taskID": { "type": "string" },
    "sources": { "type": "array" },
    "chunks": { "type": "array" },
    "rawPrivateTranscriptIncluded": { "type": "boolean" }
  }
}

