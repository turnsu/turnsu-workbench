{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-runtime-metrics.schema.json",
  "title": "Agent Runtime Metrics",
  "type": "object",
  "required": ["schemaVersion", "runID", "taskID", "startedAt", "completedAt", "durationMs"],
  "properties": {
    "schemaVersion": { "const": "agent-runtime-metrics-v1" },
    "runID": { "type": "string" },
    "taskID": { "type": "string" },
    "startedAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "durationMs": { "type": "number" }
  }
}

