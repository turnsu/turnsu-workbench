{
  "name": "wechat-onchain-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Local Agent Runtime Host for the WeChat x on-chain agent console.",
  "type": "module",
  "scripts": {
    "test": "node control-plane/smoke-test.mjs && node bin/wechat-agent-daemon.mjs --smoke-check && node bin/wechat-agent-daemon.mjs --async-smoke-check",
    "control-plane:smoke": "node control-plane/smoke-test.mjs",
    "smoke": "node bin/wechat-agent-daemon.mjs --smoke-check",
    "async-smoke": "node bin/wechat-agent-daemon.mjs --async-smoke-check",
    "start": "node bin/wechat-agent-daemon.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.75.5",
    "typebox": "1.1.38"
  }
}
