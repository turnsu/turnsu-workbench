{
  "name": "@turnsu/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && node scripts/build-host.mjs host-dist",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --test src/*.test.mjs test/*.test.mjs",
    "test:electron": "npm run build && electron test/electron-host-smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "1.18.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "electron": "44.4.5",
    "@electron/packager": "20.3.0"
  }
}
