{
  "name": "@looloomi/workbench-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical public contracts for the Workbench Product API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
