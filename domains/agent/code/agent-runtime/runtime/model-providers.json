{
  "version": "wechat-agent-model-providers-v1",
  "providers": [
    {
      "provider": "deepseek",
      "role": "text_planner_tool_calling",
      "protocol": "openai-chat-completions",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "baseUrlEnv": "DEEPSEEK_BASE_URL",
      "defaultBaseUrl": "https://api.deepseek.com",
      "chatCompletionsPath": "/chat/completions",
      "defaultModelEnv": "DEEPSEEK_DEFAULT_MODEL",
      "defaultModel": "deepseek-v4-pro",
      "fastModelEnv": "DEEPSEEK_FAST_MODEL",
      "fastModel": "deepseek-v4-flash",
      "requiredEnv": ["DEEPSEEK_API_KEY"]
    },
    {
      "provider": "kimi",
      "role": "vision_attachment_analysis",
      "protocol": "openai-chat-completions",
      "apiKeyEnv": "KIMI_API_KEY",
      "baseUrlEnv": "KIMI_BASE_URL",
      "defaultBaseUrl": "https://api.moonshot.cn/v1",
      "chatCompletionsPath": "/chat/completions",
      "defaultModelEnv": "KIMI_VISION_MODEL",
      "defaultModel": "kimi-k2.6",
      "requiredEnv": ["KIMI_API_KEY"]
    }
  ]
}
