{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-control-plane-manifest.schema.json",
  "title": "Agent Control Plane Manifest",
  "type": "object",
  "required": ["schemaVersion", "runID", "taskID", "publicSurfaceOnly", "internalToolsExposed", "stages", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "agent-control-plane-manifest-v1" },
    "runID": { "type": "string" },
    "taskID": { "type": "string" },
    "publicSurfaceOnly": { "type": "boolean" },
    "internalToolsExposed": { "type": "boolean" },
    "stages": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array" }
  }
}

