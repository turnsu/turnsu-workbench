{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-context-retrieval-plan.schema.json",
  "title": "Agent Context Retrieval Plan",
  "type": "object",
  "required": ["schemaVersion", "runID", "taskID", "strategy", "budget", "selectedChunkIDs"],
  "properties": {
    "schemaVersion": { "const": "agent-context-retrieval-plan-v1" },
    "runID": { "type": "string" },
    "taskID": { "type": "string" },
    "strategy": { "type": "string" },
    "budget": { "type": "object" },
    "selectedChunkIDs": { "type": "array", "items": { "type": "string" } }
  }
}

