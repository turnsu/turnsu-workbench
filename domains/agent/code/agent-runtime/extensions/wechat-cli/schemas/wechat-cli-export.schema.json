{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wechat-cli-export.schema.json",
  "title": "WeChatCLI Export",
  "type": "object",
  "required": ["messages"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "source": { "type": "string" },
    "sessions": { "type": "array", "items": { "type": "object" } },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "messageID": { "type": "string" },
          "sessionID": { "type": "string" },
          "sessionName": { "type": "string" },
          "sender": { "type": "string" },
          "sentAt": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
