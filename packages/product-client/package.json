{
  "name": "@turnsu/product-client",
  "version": "0.1.0",
  "private": true,
  "description": "Strict schema-driven Product API client shared by Looloomi Web and Desktop.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./readiness": {
      "types": "./dist/readiness.d.ts",
      "import": "./dist/readiness.js"
    },
    "./inbox": {
      "types": "./dist/inbox.d.ts",
      "import": "./dist/inbox.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./work-items": {
      "types": "./dist/work-items.d.ts",
      "import": "./dist/work-items.js"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js"
    },
    "./devices": {
      "types": "./dist/devices.d.ts",
      "import": "./dist/devices.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "import": "./dist/scope.js"
    },
    "./runs": {
      "types": "./dist/runs.d.ts",
      "import": "./dist/runs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@turnsu/workbench-contracts": "file:../contracts"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
